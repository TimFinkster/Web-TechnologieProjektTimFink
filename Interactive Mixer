<!DOCTYPE html>
<html lang="de">
<head>
    <title>Interactive Mixer | Tim Fink</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <meta name="author" content="Tim Fink">
    <meta name="description" content="Interaktiver Stem-Mixer im DAW-Design mit nativer JavaScript Audio-Steuerung.">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <nav>
        <a href="HTMLPage1.html">Home</a>
        <a href="releases.html">Releases</a>
        <a href="Interactive Mixer.html" class="active" aria-current="page">Interactive Mixer</a>
        <a href="booking.html">Booking</a>
        <a href="Team-Impressum.html">Team / Impressum</a>
    </nav>

    <header>
        <h1>Interactive Studio</h1>
        <p>Echtzeit Audio-Processing per nativer JavaScript-Steuerung</p>
    </header>

    <main class="daw-container">

        <div class="daw-header">
            <div class="song-selector">
                <select id="songSelect">
                    <option value="du_sagst_nichts">Du sagst nichts</option>
                    <option value="aquarium">Aquarium</option>
                </select>
            </div>

            <button class="glow-button" id="masterPlayBtn">
                <span id="playBtnText">▶ START AUDIO ENGINE</span>
            </button>
        </div>

        <!-- Die Stylische Timeline statt Frequenz-Analyzer -->
        <div class="timeline-container">
            <div class="timeline-wrapper">
                <span class="time-label" id="currentTime">0:00</span>
                <div class="timeline-track">
                    <div class="timeline-progress" id="progressBar"></div>
                    <input type="range" class="timeline-slider" id="seekSlider" min="0" max="100" value="0">
                </div>
                <span class="time-label" id="duration">0:00</span>
            </div>
        </div>

        <div class="mixer-board" id="mixerBoard">
            <!-- Wird von JavaScript dynamisch mit Spuren gefüllt -->
        </div>

    </main>

    <footer>&copy; 2026 Tim Fink | Web-Technologien Projekt | FH Salzburg</footer>

    <script>
        // Exakte Einbindung deiner Dateien
        const songs = {
            "du_sagst_nichts": [
                { name: "Vocals", file: "dusagstnichts_vocals.mp3" },
                { name: "Backings", file: "dusagstnichts_backing.mp3" },
                { name: "Drums", file: "dusagstnichts_drums.mp3" },
                { name: "Synths", file: "dusagstnichts_synths.mp3" }
            ],
            "aquarium": [
                { name: "Backings", file: "aquarium_backings.mp3" },
                { name: "Beat", file: "aquarium_beat.mp3" },
                { name: "Vocals", file: "aquarium_vocals.mp3" }
            ]
        };

        const songSelect = document.getElementById('songSelect');
        const mixerBoard = document.getElementById('mixerBoard');
        const playBtn = document.getElementById('masterPlayBtn');
        const playBtnText = document.getElementById('playBtnText');

        let isPlaying = false;
        let trackSources = [];

        // UI aufbauen und Audio-Elemente erstellen
        function buildMixer(songKey) {
            mixerBoard.innerHTML = '';
            const stems = songs[songKey];
            trackSources = [];

            stems.forEach((stem, index) => {
                const channel = document.createElement('div');
                channel.className = 'channel-strip';
                channel.innerHTML = `
                    <div class="track-name">${stem.name}</div>
                    <button class="mute-btn" id="mute-${index}">M</button>
                    <div class="fader-container">
                        <input type="range" class="vertical-fader" id="vol-${index}" min="0" max="1" step="0.01" value="0.8">
                    </div>
                `;
                mixerBoard.appendChild(channel);

                // Audio-Element anlegen
                const audioEl = new Audio(stem.file);
                audioEl.loop = true;

                const volSlider = document.getElementById(`vol-${index}`);
                const muteBtn = document.getElementById(`mute-${index}`);

                audioEl.volume = volSlider.value;

                volSlider.addEventListener('input', (e) => {
                    audioEl.volume = e.target.value;
                    if (e.target.value > 0) muteBtn.classList.remove('muted');
                });

                muteBtn.addEventListener('click', () => {
                    if (muteBtn.classList.contains('muted')) {
                        audioEl.volume = volSlider.value;
                        muteBtn.classList.remove('muted');
                    } else {
                        audioEl.volume = 0;
                        muteBtn.classList.add('muted');
                    }
                });

                trackSources.push(audioEl);
            });
        }

        // Initialer Aufbau
        buildMixer(songSelect.value);

        // Songwechsel
        songSelect.addEventListener('change', (e) => {
            trackSources.forEach(audio => {
                audio.pause();
                audio.src = '';
            });
            if (isPlaying) {
                playBtn.classList.remove('playing');
                playBtnText.innerText = '▶ START AUDIO ENGINE';
                isPlaying = false;
            }
            buildMixer(e.target.value);
        });

        // Play/Pause Steuerung
        function togglePlay() {
            if (!isPlaying) {
                trackSources.forEach(audio => {
                    audio.play().catch(err => {
                        console.error("Audiodatei nicht gefunden:", err);
                    });
                });
                playBtn.classList.add('playing');
                playBtnText.innerText = '⏸ PAUSE';
                isPlaying = true;
            } else {
                trackSources.forEach(audio => audio.pause());
                playBtn.classList.remove('playing');
                playBtnText.innerText = '▶ START AUDIO ENGINE';
                isPlaying = false;
            }
        }

        playBtn.addEventListener('click', togglePlay);

        // Timeline Update Logik
        function updateTimeline() {
            requestAnimationFrame(updateTimeline);
            
            if (trackSources.length > 0) {
                const audio = trackSources[0];
                const seekSlider = document.getElementById('seekSlider');
                const progressBar = document.getElementById('progressBar');
                const currentTimeEl = document.getElementById('currentTime');
                const durationEl = document.getElementById('duration');

                if (audio.duration) {
                    seekSlider.max = audio.duration;
                    seekSlider.value = audio.currentTime;
                    progressBar.style.width = (audio.currentTime / audio.duration) * 100 + '%';
                    currentTimeEl.textContent = formatTime(audio.currentTime);
                    durationEl.textContent = formatTime(audio.duration);
                }
            }
        }

        // Hilfsfunktion für Zeitformatierung
        function formatTime(seconds) {
            if (isNaN(seconds)) return '0:00';
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        // Seek-Slider Event Listener
        document.getElementById('seekSlider').addEventListener('input', (e) => {
            trackSources.forEach(audio => {
                audio.currentTime = e.target.value;
            });
        });

        // Timeline starten
        updateTimeline();
    </script>
</body>
</html>
